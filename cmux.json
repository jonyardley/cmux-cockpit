{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "customSidebars": {
    "renderer": "inProcess",
    "beta": {
      "enabled": true
    }
  },
  "schemaVersion": 1,
  "workspaceColors": {
    "selectionColor": "#eeece2",
    "notificationBadgeColor": "#d97757",
    "indicatorStyle": "solidFill"
  },
  "sidebarAppearance": {
    "lightModeTintColor": "#f2f0e5",
    "darkModeTintColor": "#1f1e1d",
    "tintOpacity": 0.55
  },
  "notifications": {
    "paneFlashColor": "#d97757"
  },
  "terminal": {
    "sessionContentMaxWidth": 730,
    "sessionContentAlignment": "left"
  },
  "paneBorderColor": "#e8e6dc",
  "activePaneBorderColor": "#d97757",
  "agentChat": {
    "fonts": {
      "sansFamily": "system-ui, -apple-system, \"SF Pro Text\", \"Helvetica Neue\", sans-serif",
      "baseSize": 15,
      "monoFamily": "\"Maple Mono\", ui-monospace, SFMono-Regular, monospace",
      "codeSize": 13,
      "codeLineHeight": 1.5
    }
  },
  "sidebar": {
    "branchLayout": "inline",
    "notificationMessageLineLimit": 2,
    "openPullRequestLinksInCmuxBrowser": false,
    "openPortLinksInCmuxBrowser": false
  },
  "app": {
    "reorderOnNotification": true
  }
}
