// board.swift — flat session list, verified rendering on cmux 0.64.22.
//
// Findings for this build, each learned by rendering rather than reading the
// docs (cmux.com's sidebar guide describes a newer build than 0.64.22):
//
//   1. A view produced by a user `func` never appears. Keep every view inline.
//   2. `Button` sizes to its own content, so rows space themselves out and
//      titles truncate early. Use plain stacks with `.onTapGesture`.
//   3. The `.js` reactive runtime does not exist here: `cmux sidebar validate`
//      ignores a `.js` file entirely. Only `.swift` and `.json` are real.
//   4. `cmux sidebar validate` proves the file parses, nothing more. A file
//      that validates can still render an empty sidebar, so verify by looking.
//
// Grouping rows into Needs you / Working / Idle sections is still unproven on
// this build: the version that did it rendered no rows at all. Sections are
// parked until an `if` + `.filter` construct is confirmed to evaluate here.

VStack(alignment: .leading, spacing: 1) {
    HStack(spacing: 6) {
        Text("Sessions")
            .font(.system(size: 12))
            .fontWeight(.semibold)
            .foregroundColor(.secondary)
        Spacer()
        Text("\(workspaceCount)")
            .font(.system(size: 10, design: .monospaced))
            .foregroundColor(.secondary)
    }
    .padding(.horizontal, 10)
    .padding(.vertical, 6)

    Divider()

    ForEach(workspaces) { w in
        VStack(alignment: .leading, spacing: 2) {
            HStack(spacing: 7) {
                Text(w.selected ? "●" : "○")
                    .font(.system(size: 9))
                    .foregroundColor(w.selected ? Color("#d97757") : .secondary)
                Text(w.title)
                    .font(.system(size: 13))
                    .foregroundColor(w.selected ? .primary : .secondary)
                    .lineLimit(1)
                    .truncationMode(.tail)
                Spacer()
                Text(w.unread > 0 ? "\(w.unread)" : "")
                    .font(.system(size: 10))
                    .fontWeight(.semibold)
                    .foregroundColor(Color("#d97757"))
            }
            HStack(spacing: 8) {
                Text(w.branch != nil ? w.branch : "")
                    .font(.system(size: 10, design: .monospaced))
                    .foregroundColor(.secondary)
                    .lineLimit(1)
                Spacer()
            }
            .padding(.leading, 16)
        }
        .padding(.horizontal, 10)
        .padding(.vertical, 5)
        .frame(maxWidth: .infinity, alignment: .leading)
        .background(w.selected ? Color("#7f7f7f3d") : Color("#00000000"))
        .cornerRadius(8)
        .onTapGesture { cmux("workspace.select", workspace_id: w.id) }
    }

    Spacer()
}
