#!/bin/sh
# Installed by `npm run hooks`. Rebuilds sidebars/*.js after switching
# branches, since those files are no longer committed. Quiet no-op before
# `npm ci` has run.
if [ ! -d node_modules ]; then
  exit 0
fi
npm run --silent build

# A fresh build of sidebars/*.js has seemed to drop cmux out of custom
# right-sidebar mode (not reproduced; #27 has the confirmed cause, window
# creation), so restore it here as a cheap safeguard.
# Only on a branch checkout (git's third arg is 1, not a same-branch file
# checkout), only in the main checkout (cmux loads its sidebars from there,
# and agents creating worktrees must not reset it mid-session), only when
# cmux is on PATH, and this must never fail the checkout, so every error is
# swallowed.
if [ "$3" = "1" ] &&
  [ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] &&
  command -v cmux >/dev/null 2>&1; then
  cmux right-sidebar set custom agents >/dev/null 2>&1
fi

exit 0
