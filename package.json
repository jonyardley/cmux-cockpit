{
  "name": "cmux-cockpit",
  "private": true,
  "description": "Jon's cmux sidebars and app config",
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node --watch-path=src scripts/build.ts",
    "lint": "biome ci --error-on-warnings .",
    "fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "knip": "knip",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/model.ts' --test-coverage-include='src/cockpit/{status,drop,lanes,state}.ts' --test-coverage-include='src/shared/**' --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=80",
    "validate": "node scripts/validate.ts",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run build && npm run coverage && npm run validate",
    "hooks": "git config core.hooksPath .githooks",
    "agents": "cmux right-sidebar set custom agents"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "knip": "6.38.0",
    "typescript": "7.0.2"
  }
}
